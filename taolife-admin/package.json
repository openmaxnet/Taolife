{
  "name": "taolife-admin",
  "version": "1.0.0",
  "private": true,
  "description": "道养生活管理后台 基于 Vue3, Vite5, Typescript, Naive UI.",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev --port 9980",
    "dev:prod": "vite --mode production",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "preview": "vite preview --port 9981",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "vue-tsc --noEmit",
    "sizecheck": "npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "alova": "^3.5.1",
    "colord": "^2.9.3",
    "cos-js-sdk-v5": "^1.10.1",
    "echarts": "^6.0.0",
    "md-editor-v3": "^6.4.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pro-naive-ui": "^3.2.3",
    "quill": "^2.0.3",
    "radash": "^12.1.1",
    "vue": "^3.5.32",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "web-vitals": "^5.0.0"
  },
  "devDependencies": {
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify/vue": "^5.0.0",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "lint-staged": "^16.4.0",
    "naive-ui": "^2.44.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "sass": "^1.99.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.2",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.8",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
