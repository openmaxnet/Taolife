# 项目根目录
VITE_BASE_URL = /

# 项目名称
VITE_APP_NAME = TaoLife Admin

# 路由模式 web ｜ hash
VITE_ROUTE_MODE = web

# 路由加载模式 static ｜ dynamic
VITE_ROUTE_LOAD_MODE = dynamic

# 设置登陆后跳转地址
VITE_HOME_PATH = /workbench

# 本地存储前缀
VITE_STORAGE_PREFIX =

# 版权信息
VITE_COPYRIGHT_INFO = All Right Rescived TaoLife © 2026

# 自动刷新token
VITE_AUTO_REFRESH_TOKEN = Y

# 默认多语言 enUS | zhCN
VITE_DEFAULT_LANG = zhCN

# API加密（与后端 taolife.security.encrypt.enabled 同步开启）
VITE_API_ENCRYPT = false

# HMAC签名密钥（与后端 taolife.security.encrypt.hmac-secret 相同）
VITE_ENCRYPT_HMAC_SECRET =YOUR_HMAC_SECRET
